{
  "$id": "https://github.com/richardhedges/IntelMKLFixup/blob/main/whitelist/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "application_family": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
            "type": "string"
          },
          "basename": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
            "type": "string"
          },
          "display_name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
            "type": "string"
          },
          "path_rule_id": {
            "enum": [
              "discord-stable-krisp-path-v1"
            ]
          },
          "signing_identifier": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "type": "string"
          },
          "signing_policy_id": {
            "enum": [
              "valid-runtime-no-adhoc-v1"
            ]
          },
          "team_identifier": {
            "oneOf": [
              {
                "pattern": "^[A-Z0-9]{10}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "team_identifier_policy": {
            "enum": [
              "exact",
              "absent"
            ]
          }
        },
        "required": [
          "id",
          "application_family",
          "display_name",
          "path_rule_id",
          "basename",
          "signing_identifier",
          "team_identifier_policy",
          "team_identifier",
          "signing_policy_id"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "expires_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "image_variants": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "match_mode": {
                  "const": "strict_variant"
                }
              }
            },
            "then": {
              "properties": {
                "search_window": {
                  "type": "null"
                },
                "target_file_offset": {
                  "maximum": 4294967295,
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "match_mode": {
                  "const": "bounded_window"
                }
              }
            },
            "then": {
              "properties": {
                "search_window": {
                  "type": "object"
                },
                "target_file_offset": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "match_mode": {
                  "const": "image_scan"
                }
              }
            },
            "then": {
              "properties": {
                "search_window": {
                  "type": "null"
                },
                "target_file_offset": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "allowed_patch_definition_ids": {
            "items": {
              "enum": [
                "mkl-serv-intel-cpu-true-oneapi-build-20201104-x86_64-v1"
              ]
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "application_rule_id": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
            "type": "string"
          },
          "application_version": {
            "oneOf": [
              {
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "architecture": {
            "const": "x86_64"
          },
          "cdhash": {
            "oneOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "executable_range": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "start": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          },
          "id": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
            "type": "string"
          },
          "match_mode": {
            "enum": [
              "strict_variant",
              "bounded_window",
              "image_scan"
            ]
          },
          "search_window": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "end": {
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "start": {
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_file_offset": {
            "oneOf": [
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "application_rule_id",
          "application_version",
          "architecture",
          "cdhash",
          "match_mode",
          "target_file_offset",
          "executable_range",
          "search_window",
          "allowed_patch_definition_ids"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "manifest_version": {
      "minimum": 1,
      "type": "integer"
    },
    "plugin_compatibility": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "minimum": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 3
    }
  },
  "required": [
    "schema_version",
    "manifest_version",
    "generated_at",
    "expires_at",
    "plugin_compatibility",
    "application_rules",
    "image_variants"
  ],
  "title": "IntelMKLFixup layered application policy",
  "type": "object"
}
