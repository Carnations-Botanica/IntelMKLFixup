{
  "$id": "https://github.com/Carnations-Botanica/IntelMKLFixup/blob/main/whitelist/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "manifest_version": {
      "minimum": 1,
      "type": "integer"
    },
    "plugin_compatibility": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "minimum": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "application_family": {
            "enum": [
              "discord-stable-krisp"
            ]
          },
          "application_version": {
            "maxLength": 32,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "architecture": {
            "const": "x86_64"
          },
          "cdhash": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "id": {
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
            "type": "string"
          },
          "patch_definition_id": {
            "enum": [
              "mkl-serv-intel-cpu-true-x86_64-discord-v1"
            ]
          },
          "path_rule_id": {
            "enum": [
              "discord-stable-krisp-path-v1"
            ]
          },
          "signing_identifier": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "type": "string"
          },
          "target_profile_id": {
            "enum": [
              "discord-krisp-x86_64-offset-650100-v1"
            ]
          },
          "team_identifier": {
            "oneOf": [
              {
                "pattern": "^[A-Z0-9]{10}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "application_family",
          "application_version",
          "architecture",
          "path_rule_id",
          "target_profile_id",
          "patch_definition_id",
          "signing_identifier",
          "team_identifier",
          "cdhash"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_version",
    "generated_at",
    "expires_at",
    "plugin_compatibility",
    "rules"
  ],
  "title": "IntelMKLFixup application identity whitelist",
  "type": "object"
}

